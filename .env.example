# Local CLI/setup values. Copy to .env.local; replace placeholders.
# Use this product's own provider environment, never CompanyNerve/suite values.
# WorkOS methods: Magic Auth email codes + Google only; email/password disabled.
# Google OAuth credentials belong in this product's WorkOS configuration.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Stripe settings belong in the matching Convex deployment, not the browser.
# STRIPE_ACCOUNT_ID=acct_expected_dedicated_vibescroller_account
# STRIPE_MODE=test
# STRIPE_BILLING_ROUTE=managed_payments
# STRIPE_MANAGED_PAYMENTS_VERIFIED=false
# LIVE_CHECKOUT_ENABLED=false
# Explicit verified WorkOS subjects for company invoice operators, never emails.
# Default [] grants no reporting-write or global invoice-queue access.
INVOICE_OPERATOR_SUBJECTS_JSON=[]
