# Local CLI/setup values. Copy to .env.local; replace placeholders.
# Use this product's own provider environment, never CompanyNerve/suite values.
# WorkOS methods: Magic Auth email codes + Google only; email/password disabled.
# Google OAuth credentials belong in this product's WorkOS configuration.
CONVEX_DEPLOYMENT=
# Backend-only media configuration, set on the matching Convex deployment.
# MEDIA_VERIFIED=false
# CLOUD_SANDBOX_PROVIDER=vercel
# VERCEL_MEDIA_SNAPSHOT=pinned_verified_media_snapshot
# VERCEL_CODING_SNAPSHOT=pinned_verified_coding_snapshot
# CLOUD_VERIFIED=false
# ACQUISITION_VERIFIED=false
# SANDBOX_BRIDGE_URL=https://your-public-domain/api/internal/sandbox-credentials
# SANDBOX_BRIDGE_SECRET=generated_256_bit_shared_secret
# SANDBOX_BRIDGE_ENABLED=false
# VERCEL_SANDBOX_TEAM_ID=dedicated_team
# VERCEL_SANDBOX_PROJECT_ID=dedicated_project
# SANDBOX_CREDITS_PER_SECOND=verified_compute_rate
# Vercel Production only: SANDBOX_TEAM_ID, SANDBOX_PROJECT_ID,
# SANDBOX_BRIDGE_SECRET and SANDBOX_BRIDGE_ENABLED. Never use NEXT_PUBLIC_.
NEXT_PUBLIC_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Stripe settings belong in the matching Convex deployment, not the browser.
# STRIPE_ACCOUNT_ID=acct_expected_dedicated_vibescroller_account
# STRIPE_MODE=test
# STRIPE_BILLING_ROUTE=managed_payments
# STRIPE_MANAGED_PAYMENTS_VERIFIED=false
# LIVE_CHECKOUT_ENABLED=false
# BILLING_RELEASE_APPROVED=false
# Explicit verified WorkOS subjects for company invoice operators, never emails.
# Default [] grants no reporting-write or global invoice-queue access.
INVOICE_OPERATOR_SUBJECTS_JSON=[]
