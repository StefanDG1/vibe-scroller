diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..8769d82c546bfffff391c8f0ed2279daf6f2cbcc
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,22 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Validate iteratively before any
+// recursive walker; callers cannot raise this ceiling through options.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object' || depth > 128 || seen.has(node)) {
+      throw new RangeError('Unsupported brace AST depth or cyclic nodes (maximum 128)');
+    }
+    seen.add(node);
+    if (seen.size > 100000) {
+      throw new RangeError('Unsupported brace AST node count');
+    }
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Brace nodes must be an array');
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
