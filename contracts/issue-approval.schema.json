{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "publicationRights": {
      "type": "boolean",
      "const": true
    }
  },
  "required": ["id", "version", "hash", "visibility", "publicationRights"],
  "additionalProperties": false
}
