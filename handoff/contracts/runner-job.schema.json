{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scroll.companynerve.com/contracts/runner-job.schema.json",
  "title": "Approved runner job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "workspaceId",
    "deviceId",
    "approvalId",
    "repositoryId",
    "baseSha",
    "planHash",
    "planArtifactId",
    "leaseGeneration",
    "expiresAt",
    "maxRuntimeSeconds",
    "maxCredits",
    "fundingRoute",
    "executionPolicyId",
    "networkPolicyId",
    "allowedPaths",
    "publicationMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "planArtifactId": {
      "type": "string",
      "minLength": 1
    },
    "executionPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "networkPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "leaseGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "maxRuntimeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "maxCredits": {
      "type": "integer",
      "minimum": 0
    },
    "fundingRoute": {
      "enum": [
        "local_codex_subscription",
        "local_api",
        "managed_api",
        "customer_api",
        "local_model"
      ]
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "publicationMode": {
      "enum": [
        "review_required",
        "approved_draft_only"
      ]
    }
  }
}
