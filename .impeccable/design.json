    {
      "name": "Insight evidence card",
      "kind": "card",
      "refersTo": "insight-card",
      "description": "Synthetic specimen of an insight-owned enclosure and native project disclosure.",
      "html": "<article class=\"ds-insight\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M9 18h6M10 22h4M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 3H9c0-1 0-2-1-3z\"/></svg><p>Synthetic insight: keep the next decision visible.</p><details><summary>Project connections</summary><div class=\"ds-destination\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 5v14m-5-5 5 5 5-5\"/></svg><a href=\"#synthetic-project\">Synthetic project</a><span>Illustrative current evaluation</span></div></details></article>",
      "css": ".ds-insight{font:14px/1.6 Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;padding:12px;border:1px solid var(--line,#dce5eb);border-radius:12px;background:var(--panel,#fff);color:var(--ink,#182e42)}.ds-insight>svg{color:var(--primary,#166b58)}.ds-insight p{margin:0;font-size:14px;line-height:1.5}.ds-insight details{grid-column:2;font-size:12px}.ds-insight summary{min-height:44px;padding:8px 0;cursor:pointer}.ds-destination{display:grid;grid-template-columns:minmax(0,1fr);gap:8px;padding:8px 0}.ds-destination>svg{margin-inline:auto;color:var(--primary,#166b58)}.ds-destination>a{transition:background-color 120ms ease-out,border-color 120ms ease-out;display:flex;align-items:center;padding:10px;border:1px solid var(--line,#dce5eb);border-radius:10px;color:var(--ink,#182e42)}.ds-destination span{color:var(--subtle,#526578)}.ds-destination>a:hover{background:var(--muted,#eaf0f4)}.ds-insight summary:focus-visible,.ds-destination>a:focus-visible{outline:2px solid var(--primary,#166b58);outline-offset:3px;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}:host-context([data-motion=\"off\"]) [class^=\"ds-\"]{transition:none;animation:none}"
    },
    {
      "name": "Saved topic node",
      "kind": "custom",
      "refersTo": "topic-node",
      "description": "Synthetic selected saved topic; opening evidence is separate from expanding children.",
      "html": "<div class=\"ds-node\" data-selected=\"true\"><button class=\"ds-node-open\"><span class=\"ds-node-icon\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M6 3v12a6 6 0 0 0 6-6V6\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"12\" cy=\"3\" r=\"3\"/></svg></span><strong>Synthetic topic</strong><span class=\"ds-node-count\">2 insights · 1 posts</span></button><button class=\"ds-expand\" aria-label=\"Expand synthetic topic\" aria-expanded=\"false\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button></div>",
      "css": ".ds-node{font:14px/1.6 Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;align-items:center;max-width:320px;min-width:0;border:1px solid var(--line,#dce5eb);border-radius:16px;background:var(--panel,#fff);box-shadow:0 3px 12px rgb(18 46 66 / 4%)}.ds-node[data-selected=true]{border-color:var(--primary,#166b58);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary,#166b58) 14%,transparent)}.ds-node-open{font:14px/1.6 Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;transition:background-color 120ms ease-out,border-color 120ms ease-out;display:grid;grid-template-columns:34px minmax(0,1fr);gap:3px 10px;width:100%;min-height:76px;padding:14px;border:0;border-radius:16px;background:transparent;color:var(--ink,#182e42);text-align:left;cursor:pointer}.ds-node-open strong{font-size:14px;line-height:1.35;overflow-wrap:anywhere;align-self:center}.ds-node-icon{grid-row:span 2;display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--muted,#eaf0f4);color:var(--primary,#166b58)}.ds-node-count{font-size:12px;line-height:1.4;color:var(--subtle,#526578)}.ds-expand{transition:background-color 120ms ease-out,border-color 120ms ease-out;min-width:44px;min-height:44px;border:0;background:transparent;color:var(--subtle,#526578);cursor:pointer}.ds-node button:hover{border-color:var(--primary,#166b58)}.ds-node button:focus-visible{outline:2px solid var(--primary,#166b58);outline-offset:3px;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}:host-context([data-motion=\"off\"]) [class^=\"ds-\"]{transition:none;animation:none}"
    },
    {
      "name": "Proposal recorded stage",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Synthetic recorded Saved plan marker; the label alone grants no coding authority.",
      "html": "<section class=\"ds-trail\"><h2>From saved post to change</h2><ol><li data-state=\"recorded\"><span class=\"ds-stage\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><div><strong>Saved plan</strong><p>Synthetic immutable plan record</p></div></li></ol></section>",
      "css": ".ds-trail{font:14px/1.6 Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:24px;border:1px solid var(--line,#dce5eb);border-radius:14px;background:var(--panel,#fff);color:var(--ink,#182e42)}.ds-trail h2{font-size:18px;font-weight:550;margin:0 0 20px}.ds-trail ol{padding:0;list-style:none}.ds-trail li{display:flex;gap:14px;position:relative;padding:0 0 24px}.ds-stage{display:grid;place-items:center;width:33px;height:33px;flex-shrink:0;border:1px solid transparent;border-radius:50%;background:var(--accent,#bce8da);color:var(--accent-ink,#134b40)}.ds-trail p{margin:4px 0 0;color:var(--subtle,#526578);font-size:13px}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}:host-context([data-motion=\"off\"]) [class^=\"ds-\"]{transition:none;animation:none}"
    }
  ],
  "narrative": {
    "northStar": "Scroll's knowledge atlas",
    "overview": "The app uses cool canvas, white reading surfaces, navy ink and teal selection. Its matching dark theme keeps the same hierarchy and original warm Scroll artwork. Quiet borders and compact icon-led cards let saved knowledge and the next permitted action lead. Device setting is the default appearance; Account offers Light and Dark overrides.\n\nThis is the owner-authorized October 9 application world, extracted from the built code. Its boundary is the Atlas shell, Home, Library, Projects, Account and capture. The public marketing world remains Scroll's charcoal studio. The original Scroll image is reused; this update introduces no shipping raster artwork. Product authority remains in [PRODUCT.md](PRODUCT.md), with the selected interaction scope in [the Atlas implementation contract](docs/design/ATLAS-IMPLEMENTATION-CONTRACT-20261009.md).",
    "keyCharacteristics": [
      "Cool light surfaces and matching dark surfaces with teal selection.",
      "Original Scroll artwork and visible workspace scope.",
      "Compact saved-topic branches and insight-owned evidence cards.",
      "Five phone actions: Home, Library, Save, Projects, Account.",
      "Short pointer-triggered motion with immediate keyboard actions and a still alternative.",
      "Loaded-record statistics and explicitly recorded project trails."
    ],
    "rules": [
      {
        "name": "The Recorded Meaning Rule",
        "body": "Selection and connectors describe returned records; neither color nor a line establishes permission, independent corroboration or benefit.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Keep title, explanation and metadata distinct through scale, weight and neutral contrast; use concise sentence case labels instead of ornamental eyebrows.",
        "section": "typography"
      },
      {
        "name": "The Touch Target Rule",
        "body": "Interactive controls keep at least a 44px target; small type and icons do not justify a smaller hit area. Informational chips are not controls.",
        "section": "layout"
      },
      {
        "name": "The Cited Group Rule",
        "body": "Display a connection only when all of its exact source, generation, revision and insight references exist in current permitted evidence. A connection is an explained cited group; neither its line nor topic membership proves causation or agreement.",
        "section": "components"
      },
      {
        "name": "The Recorded Outcome Rule",
        "body": "Present saving, evaluation, issue, PR, merge, deployment and benefit as separate recorded facts. A judgment is not a measured comparison, and a merged PR alone does not establish benefit.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use cool light and matching dark surfaces with theme-primary selection.",
      "**Do** reuse original Scroll artwork and preserve visible phone workspace scope.",
      "**Do** keep loading, empty, ready, success and error feedback tied to actual state.",
      "**Do** preserve visible keyboard focus, 44px controls and live reduced-motion behavior.",
      "**Do** keep evidence, scope and recorded-outcome limits explicit."
    ],
    "donts": [
      "**Don't** invent scope roots, parent links, exact totals, analysis completeness or benefit.",
      "**Don't** make a pointer reveal delay keyboard reading or action.",
      "**Don't** put a duplicate source enclosure around insight-owned cards.",
      "**Don't** publish private reference screenshots or turn a scoped fix verdict into production or full V1 acceptance."
    ]
  }
}
