  "narrative": {
    "rules": [
      {
        "name": "Selected knowledge sharing",
        "body": "Keep sharing in a native disclosure after private filing, with the shared Radix workspace choice, exact source version and seven-day duration visible before acknowledgment. Target, source version, saved grant version and replacement changes invalidate acknowledgment; closing clears loaded choices, grants and acknowledgment. Separate the action from saved grants with the scoped heading margin (28px above, 12px below). Recipient reading retains bounded rows, coverage and exact insight/revision citations. Local labeled synthetic captures fix-mobile-active-controls.png (390px), fix-desktop-active.png (1440px) and mobile-recipient-reading.png (390px) in .impeccable/review/knowledge-grants/ support a ship disposition for that spacing correction only; they do not establish real grants, second-account consent, provider/auth acceptance or production deployment.",
        "section": "components"
      },
      {
        "body": "Use mint for permitted studio actions and connections, amber for Scroll's warmth, and preserve retained neutral reading controls. Neither color proves success or benefit.",
        "name": "The Meaningful Accent Rule",
        "section": "colors"
      },
      {
        "body": "Keep title, explanation and metadata distinct through scale, weight and neutral contrast; use concise sentence case labels instead of ornamental eyebrows.",
        "name": "The Reading Hierarchy Rule",
        "section": "typography"
      },
      {
        "body": "Interactive controls keep at least a 44px target; small type and icons do not justify a smaller hit area. Informational chips are not controls.",
        "name": "The Touch Target Rule",
        "section": "layout"
      },
      {
        "body": "Keep routine content flat; use floating depth for a menu or modal that temporarily interrupts the underlying task.",
        "name": "The Flat Surface Rule",
        "section": "elevation"
      },
      {
        "body": "Keep the sampling and automatic-transcription caution visible for sampled audiovisual coverage while placing the retained full summary and detailed analysis notes in the disclosure.",
        "name": "The Visible Limits Rule",
        "section": "components"
      },
      {
        "name": "The Dialog Choice Rule",
        "body": "A modal's choice menu belongs inside its active native dialog; a visually visible menu must also accept pointer and keyboard selection. Outside dialogs the shared control retains its default portal. Appearance and token primitives are unchanged.",
        "section": "components"
      },
      {
        "name": "The Private Filing Rule",
        "body": "Organization choices describe the owner's private views; they never imply sharing permission or analysis authority. Setup rows wrap on narrow screens while action labels remain on one line. Combined browsing requires explicit confirmed setup; turning it off fences earlier responses and clears visible results.",
        "section": "components"
      }
    ],
    "donts": [
      "Don't turn a bounded CTA sweep into a looping attention effect.",
      "Don't fabricate thumbnails, totals, analysis completeness or customer outcomes.",
      "Don't publish private reference screenshots or promote the local slice into full V1 acceptance."
    ],
    "dos": [
      "Do use charcoal, meaningful mint and warm original Scroll artwork.",
      "Do keep Scroll present while allowing motion to stop.",
      "Do keep workspace scope visible on phones.",
      "Do preserve actual-state feedback, keyboard focus, 44px controls and explicit private-evidence permissions."
    ],
    "keyCharacteristics": [
      "Dark charcoal and green-gray surfaces with mint actions and amber artwork.",
      "Original Scroll remains present in the normal shell and onboarding.",
      "Readable rows, quiet borders and familiar controls.",
      "Visible workspace scope on phones; accessible focus and generous targets.",
      "Bounded local motion with a still alternative."
    ],
